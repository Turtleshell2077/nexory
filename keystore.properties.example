# Параметры подписи релизного APK.
#
# Скопируйте этот файл рядом под именем keystore.properties и подставьте свои
# значения. Настоящий keystore.properties в репозиторий НЕ попадает — в нём пароли.
#
#   copy keystore.properties.example keystore.properties
#
# ⚠️ КЛЮЧ НЕЛЬЗЯ ТЕРЯТЬ. RuStore и Google Play принимают обновления приложения
# только за подписью ТОГО ЖЕ ключа, которым была подписана опубликованная
# версия. Потеряете файл или пароль — обновить приложение в магазине будет
# невозможно, останется только публиковать новое с другим именем пакета,
# и все установившие старое к нему не перейдут.
# Держите копию .jks и паролей в надёжном месте вне рабочего компьютера.

# Путь к файлу ключа. Относительный путь считается от корня проекта,
# поэтому ключ, лежащий на уровень выше, записывается как ../nexory_key.jks
storeFile=../nexory_key.jks

# Пароль хранилища
storePassword=ВАШ_ПАРОЛЬ_ХРАНИЛИЩА

# Имя ключа внутри хранилища (алиас) и его пароль
keyAlias=ВАШ_АЛИАС
keyPassword=ВАШ_ПАРОЛЬ_КЛЮЧА
